# Public origin of the DarkPatternPrevent API server (no trailing slash).
# Local: http://127.0.0.1:3000. The web app proxies /api/v1/* to this server.
BAROMI_API_ORIGIN=https://api.example.com

# Required for account login and authenticated API calls.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# true: run screens against built-in sample data (no backend needed, e.g. previews).
NEXT_PUBLIC_DEMO_MODE=false

# AI 정밀 진단: 비우면 예시·데모만 새 화면, mock = 모든 점검에 목 데이터, api = 백엔드 엔드포인트 (docs/AI-DIAGNOSIS-DRAFT.md)
NEXT_PUBLIC_AI_DIAGNOSIS=
