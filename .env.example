DATABASE_URL="file:./prisma/dev.db"
BAROMI_CREDENTIAL_KEY="base64-encoded-32-byte-secret"
BAROMI_SPRING_AUTHORITATIVE="false"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="baromi-evidence"
BAROMI_SCAN_STALE_MS="300000"
# Comma-separated frontend origins allowed to call the API (local web app and production frontend).
BAROMI_WEB_ORIGINS="http://127.0.0.1:3001"
BAROMI_POSTGRES_PASSWORD="replace-with-local-only-password"

# Optional paid AI follow-up review. Keep the key in Secret Manager in production.
BAROMI_AI_API_URL="https://generativelanguage.googleapis.com/v1beta"
BAROMI_AI_MODEL="gemini-3.5-flash-lite"
BAROMI_AI_INPUT_USD_PER_MILLION="0.30"
BAROMI_AI_OUTPUT_USD_PER_MILLION="2.50"
BAROMI_AI_MAX_COST_USD="0.25"

# Cloud Run deployment values; set secrets through Secret Manager.
# DATABASE_URL="postgresql://..."
# BAROMI_REPORT_STORAGE="postgres"
# GOOGLE_CLOUD_PROJECT="baromi"
# CLOUD_RUN_REGION="asia-northeast3"
